<UserControl x:Class="HTCHome.Widgets.GlobalSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="HTC Home Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <GroupBox Header="Appearance">
                <StackPanel Margin="5">
                    <TextBlock Text="Skin:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboSkins" DisplayMemberPath="." SelectionChanged="ComboSkins_SelectionChanged"/>
                </StackPanel>
            </GroupBox>
            
             <TextBlock x:Name="StatusText" Text="" Margin="0,10" Foreground="Green"/>
        </StackPanel>
    </Grid>
</UserControl>
