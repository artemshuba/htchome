<Window x:Class="HTCHome.Widgets.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="350" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area -->
        <ContentControl x:Name="SettingsContent" Margin="10" Grid.Row="0"/>

        <!-- Separator -->
        <Separator Grid.Row="1" VerticalAlignment="Top"/>

        <!-- Buttons Panel -->
        <DockPanel Grid.Row="2" Margin="10" LastChildFill="False">
            <!-- Reset Button (Left) -->
            <Button x:Name="BtnReset" Content="Reset" Width="70" Padding="5" DockPanel.Dock="Left" Click="BtnReset_Click"/>

            <!-- Right Buttons -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnSave" Content="Save" Width="70" Margin="5,0,5,0" Padding="5" Click="BtnSave_Click"/>
                <Button x:Name="BtnClose" Content="Close" Width="70" Padding="5" IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
