<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Backgrounds -->
    <BitmapImage x:Key="ClockBackground" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/base_default.png"/>
    
    <!-- FlipTab Images -->
    <BitmapImage x:Key="FlipTabBackground" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_bg.png"/>
    <BitmapImage x:Key="FlipTabShadow" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_shadow.png"/>
    <BitmapImage x:Key="FlipTabDivider" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_divider.png"/>
    <BitmapImage x:Key="FlipTabCardUp" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_up.png"/>
    <BitmapImage x:Key="FlipTabCardDown" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_down.png"/>
    
    <!-- Digit Path Format -->
    <sys:String x:Key="DigitPathFormat">pack://application:,,,/Clock;component/Resources/FlipClock/Digits/{0}.png</sys:String>

    <!-- Text Style (Legacy from previous step) -->
    <Style x:Key="WidgetTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</ResourceDictionary>
