<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fonts/Colors -->
    <SolidColorBrush x:Key="DayFontColor" Color="#5b5b5d"/>

    <!-- Widget Visual Layout -->
    <DataTemplate x:Key="WidgetVisual">
        <Grid Width="300" Height="300">
            <Ellipse Fill="#DD000000" Margin="1,1,3,3"/>
            <!-- Background -->
            <Image Name="Bg" Source="pack://application:,,,/Clock;component/Resources/AnalogClockBig/clock_base_day.png"/>
            
            <!-- Date Info -->
            <TextBlock Name="Day" Text="{Binding DateString}" Margin="-90,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource DayFontColor}"/>
            
            <!-- We might need to split DateString if original had separate Day/Month... 
                 Original: Day=MON, Month=JAN 1. ViewModel provides combined "MON, JAN 1". 
                 Let's stick to combined for now or adjust ViewModel later if rigorous fidelity is needed. -->
            
            <TextBlock Name="AmPm" Text="{Binding AmPm}" Margin="0,110,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Foreground="#909091"/>

            <!-- Hands -->
            <Image Name="ClockHour" Source="pack://application:,,,/Clock;component/Resources/AnalogClockBig/clock_hour.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding HourAngle}"/>
                </Image.RenderTransform>
            </Image>
            <Image Name="ClockMinute" Source="pack://application:,,,/Clock;component/Resources/AnalogClockBig/clock_minute.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding MinuteAngle}"/>
                </Image.RenderTransform>
            </Image>
            <Image Name="ClockSecond" Source="pack://application:,,,/Clock;component/Resources/AnalogClockBig/clock_second.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding SecondAngle}"/>
                </Image.RenderTransform>
            </Image>
            
            <!-- Center Dot -->
            <Image Name="ClockDot" Source="pack://application:,,,/Clock;component/Resources/AnalogClockBig/clock_center_dot.png" Width="32" Margin="3,0,0,0"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
