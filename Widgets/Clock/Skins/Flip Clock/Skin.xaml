<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Clock.Controls;assembly=Clock">

    <!-- Resources -->
    <BitmapImage x:Key="FlipTabBackground" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_bg.png"/>
    <BitmapImage x:Key="FlipTabShadow" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_shadow.png"/>
    <BitmapImage x:Key="FlipTabDivider" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_divider.png"/>
    <BitmapImage x:Key="FlipTabCardUp" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_up.png"/>
    <BitmapImage x:Key="FlipTabCardDown" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_down.png"/>
    <sys:String x:Key="DigitPathFormat">pack://application:,,,/Clock;component/Resources/FlipClock/Digits/{0}.png</sys:String>

    <!-- Widget Visual Layout -->
    <DataTemplate x:Key="WidgetVisual">
        <Grid Margin="100,15,100,0" Width="500" Height="200">
            <Image Name="Bg" Source="pack://application:,,,/Clock;component/Resources/FlipClock/base_default.png" Stretch="Fill"/>
            
            <!-- Flip Clock -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-16,0,0">
                <controls:FlipTab x:Name="HoursTab" Value="{Binding Hours}" Delay="0.3" Margin="0,0,10,0"/>
                <controls:FlipTab x:Name="MinutesTab" Value="{Binding Minutes}" Delay="0.2" Speed="0.7"/>
            </StackPanel>

            <!-- Weather Grid (Placeholder binding until Weather logic is moved) -->
            <Grid Name="WeatherGrid">
             <StackPanel Name="WeatherStackPanel" Orientation="Vertical" Margin="7,120,0,0" HorizontalAlignment="Left">
                <StackPanel.Effect>
                    <DropShadowEffect Direction="135" ShadowDepth="1" BlurRadius="2" Opacity="0.6"/>
                </StackPanel.Effect>
                <TextBlock Name="LocationTextBlock" Foreground="White" Text="London" FontSize="16" TextWrapping="WrapWithOverflow" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="WeatherTextBlock" Foreground="White" Text="Cloudy" FontSize="13" MaxWidth="100" MaxHeight="30" Margin="0,5,0,0" TextWrapping="WrapWithOverflow"/>
            </StackPanel>
            
            <!-- Date/Temp Right Side -->
            <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Margin="0,118,7,0">
                <Grid Name="RightGrid">
                    <Grid.Effect>
                        <DropShadowEffect Direction="315" ShadowDepth="1" BlurRadius="2" />
                    </Grid.Effect>
                    <TextBlock Name="DateTextBlock" Foreground="White" Text="{Binding DateString}" FontSize="14" Margin="0,0,0,7" HorizontalAlignment="Right"/>
                    <!-- Placeholder Temp -->
                    <TextBlock Name="TempTextBlock" Foreground="White" Text="20°" FontSize="34" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,0,0"/>

                </Grid>
                </StackPanel>
            </Grid>
            <!-- Note: Complex animations and full weather/forecast logic omitted for Skin MVP. 
                 Can be re-introduced when ViewModel supports Weather data. -->
        </Grid>
    </DataTemplate>
</ResourceDictionary>
