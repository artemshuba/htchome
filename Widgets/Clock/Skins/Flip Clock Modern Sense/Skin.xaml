<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Clock.Controls;assembly=Clock">

    <!-- Resources -->
    <BitmapImage x:Key="FlipTabBackground" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_bg.png"/>
    <BitmapImage x:Key="FlipTabShadow" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_shadow.png"/>
    <BitmapImage x:Key="FlipTabDivider" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_divider.png"/>
    <BitmapImage x:Key="FlipTabCardUp" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_up.png"/>
    <BitmapImage x:Key="FlipTabCardDown" UriSource="pack://application:,,,/Clock;component/Resources/FlipClock/Background/flip_clock_tab_down.png"/>
    <sys:String x:Key="DigitPathFormat">pack://application:,,,/Clock;component/Resources/FlipClock/Digits/{0}.png</sys:String>

    <Style x:Key="WeatherBlockTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="13"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Widget Visual Layout -->
    <DataTemplate x:Key="WidgetVisual">
        <Grid Margin="100,15,100,0" Width="360" Height="200">
            <!-- Adding background under the base image to make it opaque -->
            <Rectangle Fill="#EE000000" RadiusX="10" RadiusY="10" Margin="11,10,11,10" />
            <Image Name="BackgroundImage" Source="pack://application:,,,/Clock;component/Resources/FlipClock/modern_base_default.png" Stretch="Fill" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-16,0,0">
                <controls:FlipTab x:Name="HoursTab" Value="{Binding Hours}" Delay="0.3" Margin="0,0,10,0"/>
                <controls:FlipTab x:Name="MinutesTab" Value="{Binding Minutes}" Delay="0.2" Speed="0.7"/>
            </StackPanel>

            <Grid Name="WeatherBlock" Margin="20,0,20,0" VerticalAlignment="Bottom" Height="75">
                <TextBlock Name="City" Text="{Binding WeatherCity}" Style="{StaticResource WeatherBlockTextStyle}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="1" Direction="315" ShadowDepth="2" Opacity="0.8" RenderingBias="Performance"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Name="Temp" Text="{Binding WeatherTemp}" Style="{StaticResource WeatherBlockTextStyle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Name="Weather" Text="{Binding WeatherCondition}" Style="{StaticResource WeatherBlockTextStyle}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <Image Source="{Binding WeatherIcon}" Width="130" Height="130" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
